#!/usr/bin/env python3
"""The four contract entrypoints for the authored xDSL target backend."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "compiler_library"))


def main():
    from tool_runtime import ensure_z3
    ensure_z3()
    p = argparse.ArgumentParser()
    p.add_argument("input_mlir")
    p.add_argument("--verify-diagnostics", action="store_true")
    p.add_argument("--convert-iface-to-gemmini", action="store_true")
    p.add_argument("--emit-command-buffer")
    p.add_argument("--emit-target-artifact", action="store_true")
    args = p.parse_args()
    from backend import read_program, validate_cb, emit_llvm, target_ir
    source = Path(args.input_mlir).read_text()
    if args.verify_diagnostics:
        from frontend import parse_source
        parse_source(source)
        return
    cb = read_program(source)
    from refusal import classify_refusal, declined_buffer
    refusal = classify_refusal(cb)
    if refusal is not None:
        # A stated decline is a successful compiler answer. Unknown lowering
        # exceptions still reach the ordinary diagnostic handler below.
        text = json.dumps(declined_buffer(cb, refusal), indent=2) + "\n"
        if args.emit_command_buffer:
            Path(args.emit_command_buffer).write_text(text)
        else:
            print(text, end="")
        return
    # Emission records actual task boundaries before serializing the plan.
    llvm = emit_llvm(cb, source=source) if (args.emit_target_artifact or args.emit_command_buffer) else None
    validate_cb(cb)
    if args.emit_command_buffer:
        Path(args.emit_command_buffer).write_text(json.dumps(cb, indent=2) + "\n")
    if args.emit_target_artifact:
        print(llvm, end="")
    elif not args.emit_command_buffer:
        print(target_ir(cb), end="")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"gemmini-opt: {type(error).__name__}: {error}", file=sys.stderr)
        if __import__('os').environ.get('GEMMINI_DEBUG'):
            raise
        sys.exit(1)
