#!/usr/bin/env python3
"""Four public compilation entrypoints for the authored Gemmini compiler."""
import json
import os
from pathlib import Path
import sys

PACKAGE=Path(__file__).resolve().parent
sys.path[:0]=[str(PACKAGE),str(PACKAGE/'compiler_library')]

def main():
    argv=sys.argv[1:]
    inputs=[x for x in argv if not x.startswith('-')]
    if len(inputs)!=1:
        raise ValueError('expected one input MLIR file')
    source=Path(inputs[0]).read_text()
    from gemmini_frontend import normalize_source
    if '--verify-diagnostics' in argv:
        normalize_source(source)
        return
    from gemmini_backend import compile_source
    analysis=next((x.split('=',1)[1] for x in argv if x.startswith('--emit-analysis-bundle=')),None)
    evidence_sink=None
    if analysis:
        from gemmini_activity import enable_activity
        enable_activity()
        from gemmini_evidence import write_evidence
        evidence_sink=lambda receipts,cb,lowered: write_evidence(analysis,source,cb,lowered+"\n",receipts)
    cb,lowered=compile_source(source,evidence_sink=evidence_sink)
    output=next((x.split('=',1)[1] for x in argv if x.startswith('--emit-command-buffer=')),None)
    if output:
        Path(output).write_text(json.dumps(cb,indent=2)+'\n')
    if '--emit-target-artifact' in argv or output is None:
        print(lowered)

if __name__=='__main__':
    try:
        main()
    except Exception as error:
        print(f'gemmini compiler: {type(error).__name__}: {error}',file=sys.stderr)
        if os.environ.get('GEMMINI_COMPILER_TRACEBACK'):
            import traceback
            traceback.print_exc()
        sys.exit(1)
