from pathlib import Path
import hashlib, json, re, subprocess, time

base = Path('/scratch/agustin/tmp/gemmini-golden-nofsm-20261004/out/artifacts/probes/root-resnet1930-pc-20261006')
base.mkdir(parents=True, exist_ok=False)
elf = Path('/scratch/agustin/tmp/gemmini-readout-domain-provider-20261005/out/normal_paired_readout_typed/controlled1903/build_direct/model.elf')
expected = '71e0f6aa328982492e80977a752d89c6322a80166e96ff4bdd5a0160177796ea'
assert hashlib.sha256(elf.read_bytes()).hexdigest() == expected
spike = Path('/scratch2/agustin/chipyard/.conda-env/riscv-tools/bin/spike')
argv = [str(spike), '-g', '--extension=gemmini', '--isa=rv64gc', '--instructions=100000000', str(elf)]
start = time.time()
with (base / 'stdout.log').open('w') as out, (base / 'stderr.log').open('w') as err:
    result = subprocess.run(argv, stdout=out, stderr=err, timeout=180)
stdout = (base / 'stdout.log').read_text()
stderr = (base / 'stderr.log').read_text()
assert result.returncode == 0, result.returncode
assert re.search(r'^DONE$', stdout, re.M)
assert 'OUT_SHA256 f32le 1000 4000 0c2fb2f53d4f080e8d2da3a2647b0daa6fe0759f3d15833c1af2125b3ed14787' in stdout
assert 'METRIC memref_rank_mismatch 0' in stdout
receipt = dict(scope='Actual unchanged stock1930 ELF PC census; whole-program retired instructions, not hardware cycles or a forward-only attribution', argv=argv, elapsed_seconds=time.time()-start, elf_sha256=expected, exit_code=result.returncode, full1000_exact=True, spike_sha256=hashlib.sha256(spike.read_bytes()).hexdigest(), stdout_sha256=hashlib.sha256((base/'stdout.log').read_bytes()).hexdigest(), stderr_sha256=hashlib.sha256((base/'stderr.log').read_bytes()).hexdigest(), metrics=re.findall(r'^METRIC .*$', stdout, re.M))
(base/'execution.json').write_text(json.dumps(receipt, indent=2)+'\n')
print(json.dumps(receipt, indent=2))
