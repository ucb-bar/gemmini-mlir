+    merlin_host_llvm_transform(llvm, host_isa='rv64gc', combine_clamp=True,integer_clamp=True)(source,tmp_path/'integer')
+    assert (tmp_path/'control/model.native.ll').read_bytes()==(tmp_path/'integer/model.native.ll').read_bytes()
+
+@pytest.mark.parametrize('bits', [1, 8, 16, 24])
+def test_integer_range_guard_matches_saturation_at_extreme_and_transition_values(bits):
+    lower, upper = -(1 << (bits-1)), (1 << (bits-1))-1
+    values = np.unique(np.concatenate([
+        np.arange(-32770,32771,dtype=np.int64),
+        np.array([-2**31,-2**31+1,2**31-2,2**31-1,lower-1,lower,lower+1,upper-1,upper,upper+1],dtype=np.int64),
+    ]))
+    # LLVM add deliberately has no overflow flags: unsigned range is modulo32.
+    biased=(values-lower)&0xffffffff
+    edge=(values>>31)^upper
+    actual=np.where(biased<upper-lower+1,values,edge)
+    np.testing.assert_array_equal(actual,np.clip(values,lower,upper))
+
+
+def test_integer_clamp_rejects_non_boolean_policy():
